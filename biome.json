{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "includes": [
      "**",
      "!!**/repos",
      "!**/components/ui",
      "!**/migrations",
      "!**/*.gen.ts",
      "!apps/api/src/workerConfiguration.d.ts",
      "!apps/api/src/auth/authTable.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "all",
      "a11y": "error",
      "complexity": "error",
      "correctness": "error",
      "performance": "error",
      "security": "error",
      "style": "error",
      "suspicious": "error"
    }
  },
  "overrides": [
    {
      "includes": ["**"],
      "linter": {
        "rules": {
          "correctness": {
            "useImportExtensions": "off",
            "noUndeclaredVariables": "off",
            "noUnresolvedImports": "off",
            "noNodejsModules": "off",
            "noReactNativeRawText": "off",
            "useReactNativePlatformComponents": "off",
            "noSolidDestructuredProps": "off",
            "noQwikUseVisibleTask": "off",
            "useQwikClasslist": "off",
            "useQwikLoaderLocation": "off",
            "useQwikMethodUsage": "off",
            "useQwikValidLexicalScope": "off"
          },
          "performance": {
            "noBarrelFile": "off",
            "noReExportAll": "off",
            "noImgElement": "off",
            "noJsxPropsBind": "off",
            "useSolidForComponent": "off"
          },
          "style": {
            "noExcessiveClassesPerFile": "off",
            "noHeadElement": "off",
            "noTernary": "off",
            "noJsxLiterals": "off",
            "noMagicNumbers": "off",
            "noImplicitBoolean": "off",
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "strictCase": true,
                "requireAscii": true,
                "match": "(.+?)[.](.+)",
                "filenameCases": ["camelCase", "PascalCase", "export"]
              }
            }
          },
          "suspicious": {
            "noReactSpecificProps": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/routes/**", "apps/web/example/routes/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "strictCase": true,
                "requireAscii": true,
                "match": "(?:__|_|[$])?(.+?)[.](.+)",
                "filenameCases": ["camelCase", "PascalCase", "export"]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/*.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off",
            "noProcessEnv": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/api/src/index.ts", "apps/web/src/server.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["scripts/**", ".claude/hooks/**"],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "off"
          },
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["**/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/example", "**/example/**"],
                    "message": "src/ importeert niets uit example/. Zie docs/architecture/overview.md."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/src/**/services/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/example", "**/example/**"],
                    "message": "src/ importeert niets uit example/. Zie docs/architecture/overview.md."
                  },
                  {
                    "group": [
                      "drizzle-orm",
                      "drizzle-orm/**",
                      "better-auth",
                      "better-auth/**",
                      "cloudflare:workers",
                      "**/*.drizzle",
                      "**/*.drizzle.ts",
                      "**/*.memory",
                      "**/*.memory.ts"
                    ],
                    "message": "Services hangen alleen af van ports, niet van infrastructuur of adapters. Zie docs/architecture/overview.md."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/example/**/services/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "drizzle-orm",
                      "drizzle-orm/**",
                      "better-auth",
                      "better-auth/**",
                      "cloudflare:workers",
                      "**/*.drizzle",
                      "**/*.drizzle.ts",
                      "**/*.memory",
                      "**/*.memory.ts"
                    ],
                    "message": "Services hangen alleen af van ports, niet van infrastructuur of adapters. Zie docs/architecture/overview.md."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
