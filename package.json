{
  "name": "fullstack-template",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [],
  "scripts": {
    "preinstall": "bun scripts/checkBunVersion.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "check": "bun run lint && bun run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "typescript": "7.0.2"
  }
}
