{
  "name": "fullstack-template",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [],
  "scripts": {
    "preinstall": "bun scripts/checkBunVersion.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "bun run --filter '*' typecheck && effect-tsgo tsc -p scripts",
    "check": "bun run lint && bun run typecheck && bun run test",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:api": "vitest run --project api",
    "repos:sync": "bun scripts/reposSync.ts",
    "repos:check": "bun scripts/reposCheck.ts",
    "db:generate": "bun run --cwd apps/api db:generate",
    "db:migrate": "bun run --cwd apps/api db:migrate",
    "db:studio": "bun run --cwd apps/api db:studio",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@effect/tsgo": "0.67.1",
    "@types/bun": "1.4.4",
    "husky": "9.1.7",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
