{
  "name": "@repo/api",
  "private": true,
  "type": "module",
  "dependencies": {
    "@repo/contract": "workspace:*",
    "@repo/domain": "workspace:*",
    "better-auth": "1.7.15",
    "drizzle-orm": "0.45.4",
    "effect": "4.1.2",
    "postgres": "3.4.9"
  },
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types src/workerConfiguration.d.ts --env-file .dev.vars.example",
    "typecheck": "effect-tsgo tsc --noEmit",
    "db:generate": "bun --env-file=.dev.vars run drizzle-kit generate",
    "db:migrate": "bun --env-file=.dev.vars run drizzle-kit migrate",
    "db:studio": "bun --env-file=.dev.vars run drizzle-kit studio"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11",
    "wrangler": "4.158.0"
  }
}
